# ========================================
# Universal AI Model Server Configuration
# ========================================

# MODEL SELECTION
# Specify any Hugging Face model ID that supports text generation
# Examples:
#   - deepseek-ai/deepseek-coder-1.3b-base (Recommended for coding)
#   - codellama/CodeLlama-7b (Code Llama)
#   - meta-llama/Llama-2-7b-hf (Llama 2)
#   - Qwen/Qwen-7B (Qwen)
#   - gpt2 (Lightweight option)
#   - NousResearch/Nous-Hermes-2-7b (Advanced reasoning)
MODEL_NAME=deepseek-ai/deepseek-coder-1.3b-base

# DEVICE SELECTION
# cuda - Use NVIDIA GPU (recommended for speed)
# cpu - Use CPU only (slower but works anywhere)
DEVICE=cuda

# GENERATION PARAMETERS
# Maximum total tokens (context + generation)
MAX_LENGTH=2048

# Temperature: Controls randomness (0.0-1.0)
#   0.0 = Deterministic (always same output)
#   0.5 = Conservative (good for code)
#   0.7 = Balanced (default)
#   1.0 = Maximum randomness (creative)
TEMPERATURE=0.7

# Top-P (Nucleus Sampling): Controls diversity (0.0-1.0)
#   0.9 = Conservative
#   0.95 = Balanced (default)
#   1.0 = No filtering
TOP_P=0.95

# OPTIMIZATION OPTIONS
# Enable 8-bit quantization to reduce memory usage
# Only works with CUDA GPUs, significantly reduces VRAM requirement
USE_8BIT=true

# Allow loading models with custom code
# Set to true if using models with custom code (most do)
TRUST_REMOTE_CODE=false

# SERVER CONFIGURATION
HOST=0.0.0.0
PORT=8000

# ========================================
# QUICK SETUP EXAMPLES
# ========================================

# For Fast Lightweight Inference (GPT-2)
# MODEL_NAME=gpt2
# DEVICE=cuda
# MAX_LENGTH=512
# TEMPERATURE=0.5

# For Code Generation (DeepSeek)
# MODEL_NAME=deepseek-ai/deepseek-coder-1.3b-base
# DEVICE=cuda
# MAX_LENGTH=2048
# USE_8BIT=true

# For CPU-Only (Llama 2)
# MODEL_NAME=meta-llama/Llama-2-7b-hf
# DEVICE=cpu
# MAX_LENGTH=1024
# USE_8BIT=false

# For Maximum Quality (Code Llama)
# MODEL_NAME=codellama/CodeLlama-7b
# DEVICE=cuda
# MAX_LENGTH=2048
# TEMPERATURE=0.5

